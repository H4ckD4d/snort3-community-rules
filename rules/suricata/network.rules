###############################################################################
# h4ckd4d Detection Engineering — Suricata Network Rules
# Project owner: Chris Cruz | h4ckd4d
# Defensive lab / owned-network use only.
###############################################################################

alert icmp $EXTERNAL_NET any -> $HOME_NET any (msg:"H4CKD4D NETWORK Inbound ICMP observed"; classtype:misc-activity; metadata:engine suricata, rule_id H4D-NET-1001, confidence low, severity informational; sid:2000001; rev:1;)

alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (msg:"H4CKD4D REMOTE_ACCESS Inbound SSH SYN observed"; flags:S; classtype:attempted-recon; metadata:engine suricata, rule_id H4D-NET-1002, confidence medium, severity low; sid:2000002; rev:1;)

alert tcp $EXTERNAL_NET any -> $HOME_NET 23 (msg:"H4CKD4D LEGACY_PROTOCOL Inbound Telnet SYN observed"; flags:S; classtype:policy-violation; metadata:engine suricata, rule_id H4D-NET-1003, confidence high, severity medium; sid:2000003; rev:1;)

alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"H4CKD4D NETWORK Repeated inbound TCP SYN activity"; flags:S; detection_filter:track by_src,count 20,seconds 60; classtype:attempted-recon; metadata:engine suricata, rule_id H4D-NET-1004, confidence medium, severity medium; sid:2000004; rev:1;)
