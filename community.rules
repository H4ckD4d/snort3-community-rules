###############################################################################
# h4ckd4d Detection Engineering — Snort 3 Starter Rules
# Project owner: Chris Cruz | h4ckd4d
# Purpose: Conservative defensive visibility for owned/administered networks.
# Version: 2.0.0-rc.1
# Updated: 2026-08-23
###############################################################################

# Rule 1000001 — Inbound ICMP visibility
alert icmp $EXTERNAL_NET any -> $HOME_NET any (
    msg:"H4CKD4D NETWORK Inbound ICMP observed";
    classtype:misc-activity;
    metadata:engine snort3, confidence low, severity informational;
    sid:1000001;
    rev:2;
)

# Rule 1000002 — Inbound SSH connection visibility
alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (
    msg:"H4CKD4D REMOTE_ACCESS Inbound SSH SYN observed";
    flags:S;
    classtype:attempted-recon;
    metadata:engine snort3, confidence medium, severity low;
    sid:1000002;
    rev:2;
)

# Rule 1000003 — Legacy Telnet exposure visibility
alert tcp $EXTERNAL_NET any -> $HOME_NET 23 (
    msg:"H4CKD4D LEGACY_PROTOCOL Inbound Telnet SYN observed";
    flags:S;
    classtype:policy-violation;
    metadata:engine snort3, confidence high, severity medium;
    sid:1000003;
    rev:2;
)

# Rule 1000004 — Repeated inbound TCP SYN activity
# This is a review signal only. NAT, scanners, monitoring systems, and load
# balancers may produce benign matches depending on network architecture.
alert tcp $EXTERNAL_NET any -> $HOME_NET any (
    msg:"H4CKD4D NETWORK Repeated inbound TCP SYN activity";
    flags:S;
    detection_filter:track by_src,count 20,seconds 60;
    classtype:attempted-recon;
    metadata:engine snort3, confidence medium, severity medium;
    sid:1000004;
    rev:2;
)

###############################################################################
# Notes
# - Tune $HOME_NET and $EXTERNAL_NET in the Snort configuration.
# - Validate rules with the Snort 3 configuration test before deployment.
# - Treat alerts as analyst-review signals, not proof of malicious activity.
###############################################################################
